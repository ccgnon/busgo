# ── busGO — Variables d'environnement ──────────────────────────────────
# Copiez ce fichier en .env et remplissez les valeurs

# ── Base de données ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://busgo:busgo_password@localhost:5432/busgo"
POSTGRES_USER=busgo
POSTGRES_PASSWORD=busgo_password
POSTGRES_DB=busgo

# ── Serveur ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=busgo_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# ── Frontend ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=busGO

# ── Redis (optionnel en dev) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Telegram Bot ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Groq IA ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Africa's Talking (SMS) ───────────────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=busGO

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="busGO <noreply@busgo.cm>"

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb
